{
  "manifest_version": 3,
  "name": "Tailorune",
  "version": "2.3.0",
  "description": "Tailor your resume and cover letter to a job description, entirely inside Chrome. No backend to install.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "sw/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tailor your resume with Tailorune",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "version_name": "2.3.0 (Tailorune)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Juan P. Rivera",
  "homepage_url": "https://github.com/JuanPRG/tailorune"
}
