{
  "name": "tailorune",
  "version": "0.1.0",
  "private": true,
  "description": "Resume tailoring and cover letters as a standalone Chrome extension, no backend.",
  "type": "module",
  "scripts": {
    "build": "node build/build-offscreen.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:live": "node tests/live/smoke.mjs",
    "test:live:rotation": "node tests/live/rotation.mjs",
    "bench:models": "node tests/live/modelBench.mjs",
    "assets:store": "node build/make-store-assets.mjs",
    "package": "npm run build && node build/package-extension.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.48.0"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "^0.4.3",
    "@fontsource/arimo": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "subset-font": "^2.7.0"
  }
}
