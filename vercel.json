{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "mkdir -p public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{extension/fonts/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/@napi-rs/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?path=$1" }
  ]
}
