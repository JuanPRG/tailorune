{
  "manifest_version": 3,
  "name": "Tailorune",
  "version": "2.3.0",
  "description": "Tailor your resume and cover letter to a job description, entirely inside Chrome. No backend to install.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "sw/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "version_name": "2.3.0 (Tailorune)"
}
